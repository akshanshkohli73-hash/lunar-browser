{
  "name": "lunar-browser",
  "version": "2.0.0",
  "description": "A private, intelligent, beautiful Chromium desktop browser.",
  "main": "dist/electron/main/index.cjs",
  "author": "Lunar Team",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs && npm run verify:package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:native": "node scripts/native-smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "install:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "framer-motion": "^11.11.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.lunar.browser",
    "productName": "Lunar Browser",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "assets/icons/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/lunar.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/lunar.png"
    },
    "artifactName": "Lunar-Browser-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "node-abi": "4.37.0"
  },
  "private": true,
  "license": "UNLICENSED"
}
